{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["**/.env", "**/.env.*", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "PLATFORM_DATABASE_URL",
    "REDIS_URL",
    "IPFS_API_URL",
    "IPFS_GATEWAY_URL",
    "ANVIL_RPC_URL",
    "CONTRACT_ADDRESS",
    "PLATFORM_SIGNER_SEED",
    "JWT_ACCESS_SECRET",
    "JWT_REFRESH_SECRET",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_MODEL",
    "MESHY_API_KEY",
    "SKETCHFAB_API_TOKEN",
    "POLY_PIZZA_API_KEY",
    "STUDIO_DATABASE_URL",
    "STUDIO_PLATFORM_DATABASE_URL",
    "STUDIO_MIGRATE_DATABASE_URL",
    "STUDIO_REDIS_URL",
    "STUDIO_IPFS_API_URL",
    "STUDIO_IPFS_GATEWAY_URL",
    "STUDIO_API_PORT",
    "STUDIO_CORS_ORIGINS",
    "STUDIO_JWT_ACCESS_SECRET",
    "STUDIO_PUBLISH_POLL_INTERVAL_MS",
    "STUDIO_MAX_UPLOAD_BYTES",
    "VOIDSPACE_CLIENT_MODE",
    "VOIDSPACE_CONSOLE_URL",
    "STUDIO_VOIDSPACE_API_BASE_URL",
    "STUDIO_VOIDSPACE_API_KEY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "clean": {
      "cache": false
    }
  }
}
