# Copy to ignored .env.production and replace every placeholder.
NODE_ENV=production
# A migration owner, RLS-restricted runtime role, and narrow platform role are separate.
DATABASE_URL=postgresql://void_app:REPLACE@database:5432/voidspace?schema=public
PLATFORM_DATABASE_URL=postgresql://void_platform:REPLACE@database:5432/voidspace?schema=public
MIGRATE_DATABASE_URL=postgresql://migration_owner:REPLACE@database:5432/voidspace?schema=public
REDIS_URL=rediss://REPLACE@redis:6379
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
COOKIE_SECURE=true
PUBLIC_WEB_ORIGIN=https://learning.example.com
CORS_ORIGINS=https://learning.example.com
S3_BUCKET=REPLACE
S3_REGION=us-east-1
# Leave endpoint/credentials blank for AWS with an instance/task IAM role.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
# Keep the pilot on BullMQ, or configure a production Inngest service explicitly.
LEARNING_AGENT_ENGINE=bullmq
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
INNGEST_BASE_URL=
LEARNING_HARNESS_HOST=0.0.0.0
AI_IMAGE_ENABLED=false
AI_BASE_URL=
AI_TEXT_BASE_URL=
AI_TEXT_MODEL=
AI_TEXT_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Optional OAuth credentials require registered production HTTPS callbacks.
SKETCHFAB_CLIENT_ID=
SKETCHFAB_CLIENT_SECRET=
SKETCHFAB_REDIRECT_URI=
SKETCHFAB_WEB_ORIGIN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SIWE_ENABLED=false
CHAIN_RPC_URL=
CHAIN_ID=43113
CONTRACT_ADDRESS=
PLATFORM_SIGNER_SEED=
LOG_LEVEL=info
