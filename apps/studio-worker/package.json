{
  "name": "@void-space/studio-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "BullMQ background processors for VOID·STUDIO — async publishing, generative AI jobs, CSG offload, format conversion, and autosave snapshots (VS2-SRS-1.0 §3.1, §7.5).",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "NODE_EXTRA_CA_CERTS=../../docker/certs/void-space.crt tsx watch src/server.ts",
    "start": "NODE_EXTRA_CA_CERTS=../../docker/certs/void-space.crt tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@void-space/studio-ai": "workspace:*",
    "@void-space/studio-db": "workspace:*",
    "@void-space/studio-engine": "workspace:*",
    "@void-space/types": "workspace:*",
    "@void-space/voidspace-client": "workspace:*",
    "bullmq": "^5.34.10",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
