    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.4.3",
    "@fastify/jwt": "^10.2.8",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/sensible": "^6.0.8",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "@fastify/websocket": "11.3.7",
    "@void-space/db": "workspace:*",
    "@void-space/studio-ai": "workspace:*",
    "@void-space/types": "workspace:*",
    "bullmq": "^5.34.10",
    "fastify": "^5.12.8",
    "fastify-plugin": "^6.0.1",
    "fflate": "0.8.3",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "viem": "^2.56.8",
    "zod": "^3.24.1"
  },
  "devDependencies": {
