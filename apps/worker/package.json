{
  "name": "@void-space/worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Void Space background jobs: S3 asset storage, AI enrichment, lesson agents, extraction, exports, licensing and notifications",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "learning:dev": "inngest dev --host 127.0.0.1 --no-discovery --persist -u http://127.0.0.1:4030/api/inngest"
  },
  "dependencies": {
    "@inngest/agent-kit": "^0.13.2",
    "@void-space/db": "workspace:*",
    "@void-space/ai": "workspace:*",
    "@void-space/types": "workspace:*",
    "bullmq": "^5.34.10",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.12.1",
    "inngest": "^4.27.0",
    "ioredis": "^5.4.2",
    "ipaddr.js": "^2.5.0",
    "pdfjs-dist": "5.4.624",
    "pdfkit": "0.17.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "pptxgenjs": "4.0.1",
    "sharp": "0.34.5",
    "viem": "^2.56.8",
    "zod": "^4.0.0",
    "fflate": "0.8.3",
    "@void-space/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "@types/pdfkit": "0.17.4",
    "inngest-cli": "^1.53.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
