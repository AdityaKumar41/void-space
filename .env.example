# ---------------------------------------------------------------------------
# VOID·SPACE — local development environment (VS-SRS-2.0 §9.4)
# Copy to .env and adjust. NEVER commit the real .env.
# `pnpm dev:up` fills CONTRACT_ADDRESS automatically after deploying the
# licensing contract to the local Anvil chain (§9.3).
# ---------------------------------------------------------------------------

# --- Core runtime -----------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL          : runtime role, subject to RLS. Used by api + worker.
# PLATFORM_DATABASE_URL : platform role, privileges only on Tenant/Role tables
#                         (SuperAdmin operations, §3.5). Used by api only.
# MIGRATE_DATABASE_URL  : schema owner, used by Prisma migrations & RLS apply.
DATABASE_URL=postgresql://void_app:void_app_pw@localhost:5432/voidspace?schema=public
PLATFORM_DATABASE_URL=postgresql://void_platform:void_platform_pw@localhost:5432/voidspace?schema=public
MIGRATE_DATABASE_URL=postgresql://voidspace:voidspace_pw@localhost:5432/voidspace?schema=public
POSTGRES_USER=voidspace
POSTGRES_PASSWORD=voidspace_pw
POSTGRES_DB=voidspace
POSTGRES_PORT=5432

# --- Redis (BullMQ + cache + rate limits) -----------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- IPFS (Kubo, local content-addressed storage, §3.8) ---------------------
IPFS_API_URL=http://localhost:5001
IPFS_GATEWAY_URL=http://localhost:8080
IPFS_API_PORT=5001
IPFS_GATEWAY_PORT=8080

# --- Local EVM chain (Anvil / Foundry, §3.9.1) ------------------------------
ANVIL_RPC_URL=http://localhost:8545
ANVIL_PORT=8545
ANVIL_CHAIN_ID=31337
# Written by the deploy-contracts container after forge script --broadcast.
CONTRACT_ADDRESS=
# Root seed for per-tenant managed ("publisher") wallets (§3.9.3).
# Anvil's first pre-funded test account key — LOCAL DEVELOPMENT ONLY.
PLATFORM_SIGNER_SEED=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Google SSO (optional, FR-2.2) — leave blank to disable the SSO button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost/api/v1/auth/google/callback
# Optional SIWE wallet login (FR-2.6)
SIWE_ENABLED=true
# The EIP-4361 domain/uri a signed message must match (replay protection).
SIWE_DOMAIN=localhost
SIWE_URI=https://localhost
# FR-2.3 requires Secure cookies; set to false only to browse the plain-http origin.
COOKIE_SECURE=true

# --- Web client (build-time, inlined by Next) -------------------------------
# Path the browser uses for API calls. Relative, so it works behind the edge.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Optional: a block-explorer base, e.g. https://sepolia.etherscan.io. Empty = the
# transaction hash is shown as text without a link.
NEXT_PUBLIC_CHAIN_EXPLORER_URL=

# --- Uploads (FR-3.1) -------------------------------------------------------
# Staging area for in-flight uploads before the ipfs-pin worker moves them to IPFS.
STAGING_DIR=.staging
# Optional: a hard ceiling on the staging area (bytes).
STAGING_MAX_BYTES=5368709120
# Optional: Claude model + timeout for AI enrichment (FR-7.1). Without
# ANTHROPIC_API_KEY the deterministic offline enricher is used instead.
ANTHROPIC_TIMEOUT_MS=30000

# --- Edge / TLS -------------------------------------------------------------
# nginx upstreams: use host.docker.internal:* when api/web run natively
# (`pnpm dev`), or api:4000 / web:3000 when they run inside compose.
EDGE_WEB_UPSTREAM=host.docker.internal:3000
# The edge lives in a container; these say where the app servers are.
#   containerised apps (docker compose --profile app): web:3000 / api:4000
#   native apps (pnpm dev on the host): host.docker.internal:3000 / :4000
EDGE_API_UPSTREAM=host.docker.internal:4000
EDGE_IPFS_GATEWAY_UPSTREAM=ipfs:8080
TLS_CERT_PATH=/etc/nginx/certs/void-space.crt
TLS_KEY_PATH=/etc/nginx/certs/void-space.key

# --- Optional external integrations (absent => graceful degradation, NFR-REL.1)
#
# These names are not free text: each one is read by name in `apps/api/src/env.ts` and handed to the
# adapter it configures. A value set under a different name is ignored in silence — the adapter simply
# reports itself offline forever, and nothing says why. When an adapter is added or renamed, change it
# in both places.
#
# AI enrichment (FR-7). Without a key the worker uses the deterministic
# offline enricher so the whole upload -> review -> publish flow still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# FR-6.1 Sketchfab. A single API token (`Authorization: Token …`), not an OAuth client pair.
SKETCHFAB_API_TOKEN=
# FR-6.2 Poly Pizza.
POLY_PIZZA_API_KEY=
# FR-6.4 Meshy text-to-3D.
MESHY_API_KEY=
# FR-6.3 headless Blender. Unset is a supported state: the worker records a *labelled simulation*
# with no bytes rather than failing, so the pipeline stays inspectable without the ~1 GB image.
# To run it for real, bring the optional profile up and point the worker at it:
#   docker compose --profile blender up -d blender-runner
#   BLENDER_RUNNER_URL=http://blender-runner:8090
BLENDER_RUNNER_URL=
# EoN Reality (FR-10.4). Without a URL the worker records the documented labelled simulation.
EON_API_URL=
EON_API_KEY=
# Where the public reads the pushed scene. Has a default; set it only to override the origin.
EON_PUBLIC_BASE_URL=

# --- Worker tuning (§3.10, NFR-SCAL.2) -------------------------------------
WORKER_CONCURRENCY_AI=2
WORKER_CONCURRENCY_IPFS=4
WORKER_CONCURRENCY_BLENDER=1
WORKER_CONCURRENCY_CHAIN=2
WORKER_CONCURRENCY_PUBLISH=2
WORKER_CONCURRENCY_NOTIFY=4
JOB_POLL_RATE_LIMIT_PER_MIN=120

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# VOID·STUDIO (VS2-SRS-1.0 §5, §9.2)
# ---------------------------------------------------------------------------
#
# A deliberately separate database and separate roles from VOID·SPACE's. No table is
# shared between the two and there is no cross-database foreign key (§5.3), so the two
# migrate, seed and reset independently — and a Studio migration cannot damage
# VOID·SPACE's data even by accident.
#
# Port 5433, not 5432. The offset is load-bearing: it means pointing a Studio
# migration at the wrong stack fails to connect instead of succeeding quietly against
# the wrong database.
#
#   STUDIO_DATABASE_URL          : runtime role, subject to RLS. Used by studio-api + studio-worker.
#   STUDIO_PLATFORM_DATABASE_URL : BYPASSRLS, privileges only on tenants + users — the federated
#                                  identity mirror (§5.1), which is reconciled before a tenant is
#                                  known. Used by studio-api only.
#   STUDIO_MIGRATE_DATABASE_URL  : schema owner, used by Prisma migrations & the RLS apply script.
STUDIO_DATABASE_URL=postgresql://voidstudio_app:voidstudio_app_pw@localhost:5433/voidstudio?schema=public
STUDIO_PLATFORM_DATABASE_URL=postgresql://voidstudio_platform:voidstudio_platform_pw@localhost:5433/voidstudio?schema=public
STUDIO_MIGRATE_DATABASE_URL=postgresql://voidstudio:voidstudio_pw@localhost:5433/voidstudio?schema=public
# Passwords `pnpm studio:db:rls` uses when it creates the two runtime roles above.
STUDIO_APP_DB_PASSWORD=voidstudio_app_pw
STUDIO_PLATFORM_DB_PASSWORD=voidstudio_platform_pw

# The Studio's own Redis and IPFS node (§3.1, §3.6). Both offset from VOID·SPACE's for
# the same reason as the database port, so both stacks can run at once.
STUDIO_REDIS_URL=redis://localhost:6380
STUDIO_IPFS_API_URL=http://localhost:5002
STUDIO_IPFS_GATEWAY_URL=http://localhost:8081

# Compose overrides for the Studio data tier. Defaults match the URLs above.
STUDIO_POSTGRES_USER=voidstudio
STUDIO_POSTGRES_PASSWORD=voidstudio_pw
STUDIO_POSTGRES_DB=voidstudio
STUDIO_POSTGRES_PORT=5433
STUDIO_REDIS_PORT=6380
STUDIO_IPFS_API_PORT=5002
STUDIO_IPFS_GATEWAY_PORT=8081
STUDIO_EDGE_PORT=8443

# --- VOID·STUDIO API (§6.4) ---------------------------------------------------
# The control plane behind /studio/api/v1 (apps/studio-api). It verifies VOID·SPACE's
# sessions, keeps the thin project index, and makes the one deliberate crossing into
# VOID·SPACE on publish (§3.5.2). It stores no scene data — see docs/VOID-STUDIO.md §2.2.
#
# Run it with `pnpm studio:dev` (or `pnpm studio:api:dev` for just the API). Without it
# the editor boots and models normally; its VOID·SPACE panel renders "offline" and
# publishing is the one thing that does not work.
STUDIO_API_PORT=4100
# Browser origins allowed to call this API. The editor's dev server is 5007 and the
# Studio edge is 8443; the API's own origins only matter when something else embeds it.
STUDIO_CORS_ORIGINS=https://localhost:8443,http://localhost:5007,http://localhost:3000
# Hard ceiling on an upload the API will accept, in bytes. Clears VOID·SPACE's 200 MB
# per-asset limit (VS-SRS-2.0 FR-3.1) with room for the JSON body it arrives in.
STUDIO_MAX_UPLOAD_BYTES=230686720

# --- Federated identity (§3.5.1) -------------------------------------------
# VOID·STUDIO authenticates through VOID·SPACE and stores no credential of its own.
# It verifies VOID·SPACE's signed JWT with the same secret VOID·SPACE signs with.
#
# Known cost, recorded rather than hidden: a shared HS256 secret lets the Studio mint
# VOID·SPACE tokens. Acceptable while both products are one team in one repo; the
# target is an asymmetric keypair (VOID·SPACE signs, Studio verifies with the public
# half), which needs a public-key endpoint on the VOID·SPACE side.
STUDIO_JWT_ACCESS_SECRET=
# The next two belong to the FR-1.1 redirect flow, which is NOT implemented: there is no
# Studio login page and no Studio session cookie, because the browser signs in through
# VOID·SPACE and presents that token to this API. They are read by nothing yet — see
# docs/VOID-STUDIO.md §5 before wiring them into a deployment.
# VOID·SPACE's authorization endpoint the Studio would redirect to (FR-1.1).
VOID_SPACE_AUTHORIZE_URL=https://localhost/authorize
# Where the Studio's own session cookie would be scoped, e.g. studio.localhost.
STUDIO_SESSION_COOKIE_DOMAIN=

# --- Publishing to VOID·SPACE (§3.5.2, FR-14.2) -----------------------------
# A tenant-level Developer API key (VS-SRS-2.0 FR-12.3), exchanged per publish for a
# short-lived bearer at POST /api/v1/auth/token. Server-side only: it must never reach
# the browser, where every Creator in the tenant could read it.
#
# The ORIGIN only — scheme://host[:port]. Not the /api/v1 root: VoidSpaceClient appends
# its own versioned path, so `/api/v1` here produces `/api/v1/api/v1/...` and a 404 that
# reads like a missing VOID·SPACE route. The API rejects that shape at boot.
STUDIO_VOIDSPACE_API_BASE_URL=https://localhost
STUDIO_VOIDSPACE_API_KEY=
# Which gateway the Studio talks to: `live` is a deployed VOID·SPACE, `mock` is the §9.1
# in-memory simulator (a full publish/review lifecycle with no VOID·SPACE running).
VOIDSPACE_CLIENT_MODE=live
# Where a Creator is sent to see a published asset, and the console root. Only builds
# links; nothing calls it.
VOIDSPACE_CONSOLE_URL=https://localhost
# How often a client re-reads an in-flight publish (FR-14.3). Served to the editor
# through /voidspace/status, so one value governs every client.
STUDIO_PUBLISH_POLL_INTERVAL_MS=30000

# --- AI subsystem (§7.5, FR-18.1) -------------------------------------------
# The Copilot and the pre-publish readiness check. Absent ANTHROPIC_API_KEY is a
# SUPPORTED deployment, not a misconfiguration: §7.5 requires the whole modeling and
# editing toolset to work with every AI feature off, and FR-11.10 makes the audit a
# prerequisite for publishing. Without a key the Copilot answers 503 naming this
# variable, the audit falls back to its own measurements (which is what the score is
# computed from anyway), and publishing is entirely unaffected.
#
# Server-side only. A model credential in the browser would be every Creator's to spend.
ANTHROPIC_API_KEY=
# A DATED SNAPSHOT, not a floating alias. A moving model means the Copilot's behaviour
# changes without a commit, which makes §7.5's reproducibility guarantee hollow: a
# stored CopilotMessage could not be replayed, because the model behind the name moved.
# Keep this in step with docs/VOID-STUDIO.md §2.4.
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# §7.5's hard timeout on a single provider call. Long by web standards on purpose: §7.2
# asks the model to reason over a scene summary and emit several tool calls, and a tight
# ceiling times out on exactly the multi-object instructions the feature exists for.
ANTHROPIC_TIMEOUT_MS=60000
# §7.5's per-tenant rate limit, per minute. Per TENANT rather than global, so one
# workspace's runaway loop cannot consume another's budget — which is the outcome §7.5
# states the limit is for.
STUDIO_AI_RATE_LIMIT_PER_MINUTE=30
# NOTE: MESHY_API_KEY is deliberately absent. The generative tools exist in the catalogue
# and are feature-gated (FR-18.1), but nothing runs them yet — they need apps/studio-worker,
# which does not exist. Adding the key here before that would be a setting read by nothing.
