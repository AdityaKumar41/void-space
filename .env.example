# ---------------------------------------------------------------------------
# VOID·SPACE — development environment (VS-SRS-2.0 §9.4)
# Copy to .env and adjust. NEVER commit the real .env.
# The licensing contract is deployed to Avalanche Fuji. Set the RPC URL and deployer
# key before running `pnpm contracts:deploy`.
# ---------------------------------------------------------------------------

# --- Core runtime -----------------------------------------------------------
NODE_ENV=development
WEB_PORT=3000
API_PORT=4000

# --- PostgreSQL -------------------------------------------------------------
# DATABASE_URL          : runtime role, subject to RLS. Used by api + worker.
# PLATFORM_DATABASE_URL : platform role, privileges only on Tenant/Role tables
#                         (SuperAdmin operations, §3.5). Used by api only.
# MIGRATE_DATABASE_URL  : schema owner, used by Prisma migrations & RLS apply.
DATABASE_URL=postgresql://void_app:void_app_pw@localhost:5432/voidspace?schema=public
PLATFORM_DATABASE_URL=postgresql://void_platform:void_platform_pw@localhost:5432/voidspace?schema=public
MIGRATE_DATABASE_URL=postgresql://voidspace:voidspace_pw@localhost:5432/voidspace?schema=public
POSTGRES_USER=voidspace
POSTGRES_PASSWORD=voidspace_pw
POSTGRES_DB=voidspace
POSTGRES_PORT=5432

# --- Redis (BullMQ + cache + rate limits) -----------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379


# --- EVM chain ---------------------------------------------------------------
# Leave chain publishing disabled until a Fuji RPC and current registry are configured.
# Optional local contract development: docker compose --profile local-chain up -d anvil.
CHAIN_RPC_URL=
CHAIN_ID=31337
CHAIN_EXPLORER_URL=https://testnet.snowtrace.io
# Written by `pnpm contracts:deploy` after forge script --broadcast.
CONTRACT_ADDRESS=
# Root seed for per-tenant managed ("publisher") wallets (§3.9.3).
# Use a dedicated Fuji-funded deployer/publisher key. Never commit it.
PLATFORM_SIGNER_SEED=

# --- Auth ------------------------------------------------------------------
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Google SSO (optional, FR-2.2) — leave blank to hide the button.
# Create a Web application OAuth client. Authorized redirect URI must match
# GOOGLE_REDIRECT_URI exactly. Local `pnpm dev` uses the web origin, because
# the browser calls /api/v1 on :3000 and Next proxies it to the API.
# Behind the nginx edge, use https://localhost/api/v1/auth/google/callback instead.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
# Optional SIWE wallet login (FR-2.6)
SIWE_ENABLED=true
# The EIP-4361 domain/uri a signed message must match (replay protection).
SIWE_DOMAIN=localhost
SIWE_URI=https://localhost
# FR-2.3 requires Secure cookies; set to false only to browse the plain-http origin.
COOKIE_SECURE=true

# --- Web client (build-time, inlined by Next) -------------------------------
# Path the browser uses for API calls. Relative, so it works behind the edge.
NEXT_PUBLIC_API_BASE_URL=/api/v1
# Optional: a block-explorer base, e.g. https://testnet.snowtrace.io. Empty = the
# transaction hash is shown as text without a link.
NEXT_PUBLIC_CHAIN_EXPLORER_URL=https://testnet.snowtrace.io

# --- Uploads (FR-3.1) -------------------------------------------------------
# Staging area for in-flight uploads before the asset-store worker streams them to S3.
STAGING_DIR=.staging
# Optional: a hard ceiling on the staging area (bytes).
STAGING_MAX_BYTES=5368709120
# Optional: Claude model + timeout for AI enrichment (FR-7.1). Without
# ANTHROPIC_API_KEY the deterministic offline enricher is used instead.
ANTHROPIC_TIMEOUT_MS=30000

# --- Edge / TLS -------------------------------------------------------------
# nginx upstreams: use host.docker.internal:* when api/web run natively
# (`pnpm dev`), or api:4000 / web:3000 when they run inside compose.
EDGE_WEB_UPSTREAM=host.docker.internal:3000
# The edge lives in a container; these say where the app servers are.
#   containerised apps (docker compose --profile app): web:3000 / api:4000
#   native apps (pnpm dev on the host): host.docker.internal:3000 / :4000
EDGE_API_UPSTREAM=host.docker.internal:4000
TLS_CERT_PATH=/etc/nginx/certs/void-space.crt
TLS_KEY_PATH=/etc/nginx/certs/void-space.key

# --- Optional external integrations (absent => graceful degradation, NFR-REL.1)
#
# These names are not free text: each one is read by name in `apps/api/src/env.ts` and handed to the
# adapter it configures. A value set under a different name is ignored in silence — the adapter simply
# reports itself offline forever, and nothing says why. When an adapter is added or renamed, change it
# in both places.
#
# AI enrichment (FR-7). Without a key the worker uses the deterministic
# offline enricher so the whole upload -> review -> publish flow still works.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
# Sketchfab Authorization Code application. The secret belongs on the API only.
SKETCHFAB_CLIENT_ID=
SKETCHFAB_CLIENT_SECRET=
SKETCHFAB_REDIRECT_URI=http://localhost:3000/api/v1/tools/sketchfab/callback
SKETCHFAB_WEB_ORIGIN=http://localhost:3000

# --- Worker tuning (§3.10, NFR-SCAL.2) -------------------------------------
WORKER_CONCURRENCY_AI_ENRICHMENT=2
WORKER_CONCURRENCY_CHAIN_LICENSE=2
WORKER_CONCURRENCY_NOTIFY=4
JOB_POLL_RATE_LIMIT_PER_MIN=120

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Shared server-side text AI (lessons, metadata enrichment).
# No endpoint => local/offline operation. Use a host, /v1 base, chat endpoint,
# or native /api/generate endpoint; auto detects the native generate format.
# Suggested local deployment:
# AI_BASE_URL=https://qwen.cutm.ac.in
# AI_TEXT_BASE_URL=https://qwen.cutm.ac.in/api/generate
# AI_TEXT_MODEL=qwen2.5-coder:32b
# AI_TEXT_FALLBACK_MODEL=mistral:7b
AI_BASE_URL=
AI_TEXT_BASE_URL=
AI_TEXT_MODEL=qwen2.5-coder:32b
AI_TEXT_FALLBACK_MODEL=
AI_TEXT_PROTOCOL=auto
AI_TEXT_API_KEY=
AI_TEXT_TIMEOUT_MS=30000
# Optional OpenRouter: both key and model must be supplied to enable it.
# Prefer it over the compatible endpoint only when explicitly enabled.
# Free-only rejects paid model IDs and sends a zero-price provider ceiling.
OPENROUTER_PREFERRED=false
OPENROUTER_FREE_ONLY=false
# Enable only with a model that supports disabling reasoning (not mandatory-reasoning models).
OPENROUTER_DISABLE_REASONING=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional private educational illustration generation (server-side Flux).
AI_IMAGE_BASE_URL=
AI_IMAGE_ENABLED=true
AI_IMAGE_MODEL=flux
AI_IMAGE_API_KEY=

# Optional marketplace payments. Production requires both Stripe secrets.
# Register /api/v1/commerce/webhook for checkout.session.completed and
# checkout.session.async_payment_succeeded. Blank settings disable paid checkout
# in production; development shows an explicitly labelled, no-charge demo.
PUBLIC_WEB_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PLATFORM_FEE_BPS=1000

# Optional on-chain skill credentials (separate from asset licensing).
# Deploy the current SkillCredentialRegistry source, then configure its address.

# AI-first learning workspace. Private files require the same STAGING_DIR mount in API + worker.
LEARNING_TEACHER_DAILY_JOBS=30
LEARNING_LEARNER_DAILY_JOBS=10
LEARNING_GENERATION_TIMEOUT_MS=90000
WORKER_CONCURRENCY_LEARNING=2
# Optional existing provider model dedicated to lesson drafts; no implicit paid provider.
# LEARNING_GENERATION_MODEL=mistral:7b

# Local learning agents (start `pnpm learning:dev` alongside API + worker)
LEARNING_AGENT_ENGINE=bullmq
INNGEST_DEV=1
INNGEST_BASE_URL=http://127.0.0.1:8288
LEARNING_HARNESS_PORT=4030
# Optional OpenAI-compatible vision endpoint; images are never sent to text-only models.
AI_VISION_BASE_URL=
AI_VISION_MODEL=
AI_VISION_API_KEY=

# Shared private object storage. Leave all S3 fields empty to retain legacy local files.
# Local MinIO uses the same S3 adapter as production; never make its bucket public.
S3_BUCKET=
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Container access to local MinIO; leave blank for AWS or use your container endpoint.
S3_CONTAINER_ENDPOINT=http://host.docker.internal:9000
WORKER_CONCURRENCY_ASSET_STORE=4
